{
  "schemaVersion": 1,
  "id": "architects_toolbox",
  "version": "${version}",
  "name": "Architect's Toolbox",
  "description": "Measurement, visualization, and clipboard tools for Minecraft builders",
  "authors": [
    "ArchitectsToolbox"
  ],
  "license": "All Rights Reserved",
  "icon": "assets/architects_toolbox/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ArchitectsToolbox.fabric.client.ArchitectsToolboxFabricClient"
    ],
    "modmenu": [
      "com.ArchitectsToolbox.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "architects_toolbox.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.10",
    "java": ">=21",
    "architectury": ">=18.0.6",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
